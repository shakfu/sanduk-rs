{
  "name": "rust",
  "description": "Rust 1.98.1 with clippy and rustfmt, through rustup; cargo's cache is writable by the agent",
  "tools": [
    {
      "name": "cc",
      "type": "apt",
      "description": "The linker and C compiler cargo and build scripts call",
      "install": ["build-essential", "pkg-config"]
    },
    {
      "name": "rustup-init",
      "type": "binary",
      "description": "rustup 1.29.1, MIT/Apache-2.0",
      "artifacts": {
        "amd64": {
          "url": "https://static.rust-lang.org/rustup/archive/1.29.1/x86_64-unknown-linux-gnu/rustup-init",
          "sha256": "dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71"
        },
        "arm64": {
          "url": "https://static.rust-lang.org/rustup/archive/1.29.1/aarch64-unknown-linux-gnu/rustup-init",
          "sha256": "15f6e4ce9f583b929c996c91562bad6d4454f3281de858b02cdfdef615fac433"
        }
      }
    },
    {
      "name": "toolchain",
      "type": "run",
      "description": "The toolchain as the official rust image lays it out; rustup checks its own downloads",
      "lines": [
        "export RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo",
        "rustup-init -y --no-modify-path --profile minimal --default-toolchain 1.98.1 -c clippy -c rustfmt",
        "rm /usr/local/bin/rustup-init",
        "chmod -R a+w \"$RUSTUP_HOME\" \"$CARGO_HOME\"",
        "for bin in \"$CARGO_HOME\"/bin/*; do ln -s \"$bin\" /usr/local/bin/; done"
      ]
    }
  ],
  "env": {
    "RUSTUP_HOME": "/usr/local/rustup",
    "CARGO_HOME": "/usr/local/cargo"
  }
}
